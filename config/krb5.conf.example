# Kerberos configuration for proxy-gateway. Copy to data/conf/krb5.conf (scripts/init does this)
# and replace the realm and the domain controllers with your own.
[logging]
	default = FILE:/var/log/krb5.log

[libdefaults]
	default_realm = EXAMPLE.COM
	kdc_timesync = 1
	ccache_type = 4
	forwardable = true
	proxiable = true
	renew_lifetime = 7d

[realms]
	EXAMPLE.COM = {
		kdc = dc1.example.com
		kdc = dc2.example.com
		admin_server = dc1.example.com
		default_domain = example.com
	}

[domain_realm]
	.example.com = EXAMPLE.COM
	example.com = EXAMPLE.COM
