root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[Makefile]
indent_style = tab

[cntlm-gss/cntlm-0.92.3/**]
# upstream sources: keep their formatting
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
