# Copy to .env (scripts/init does this) and edit. .env is git-ignored.
# Your directory (Active Directory / Kerberos) user name, without the realm.
AD_USER=your-ad-user
# Port that cntlm listens on, bound to 127.0.0.1 on the host.
PROXY_PORT=3128
# Alpine base image version for the build.
ALPINE_VERSION=3.17
# Set to 1 only if apk cannot verify TLS (for example behind a TLS-inspecting proxy
# whose CA you have not added to cntlm-gss/certs/). It downgrades the package
# repositories to http during the image build.
APK_USE_HTTP=0
# Config files inside the container; they are read from ./data/conf (mounted read-only).
CNTLM_CONFIG=/data/conf/cntlm.conf
KRB5_CONFIG=/data/conf/krb5.conf
KRB5CCNAME=/tmp/krb5cc_1000
