#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2025 Gregor Koporec
# update-proxy - render system proxy settings from /etc/proxy.conf (single source of truth).
#
# Usage: update-proxy [--dry-run | --check] [--off] [--apply-services]
#   (none)            write the derived files that differ from /etc/proxy.conf
#   --dry-run         show a diff of what would change; change nothing
#   --check           exit 1 if any derived file differs from /etc/proxy.conf; change nothing
#   --off             render as disabled (remove derived settings) without editing /etc/proxy.conf
#   --apply-services  also run `systemctl daemon-reload` and restart docker when its drop-in changed
#
# Environment: ROOT (default empty) prefixes every system path, for tests in a sandbox.
#              PROXY_CONF overrides the config path.
# The script never reads or writes credentials: the AD password lives in data/secrets/ad_pass
# and is used only by the cntlm container. ~/.docker/config.json (registry logins) is not touched.
set -euo pipefail

ROOT="${ROOT:-}"
CONF="${PROXY_CONF:-${ROOT}/etc/proxy.conf}"
MODE=apply; FORCE_OFF=0; SERVICES=0
BEGIN="# BEGIN update-proxy (generated, do not edit)"
END="# END update-proxy"

die() { echo "update-proxy: $*" >&2; exit 2; }
usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }

for a in "$@"; do
  case "$a" in
    --dry-run) MODE=dry ;;
    --check) MODE=check ;;
    --off) FORCE_OFF=1 ;;
    --apply-services) SERVICES=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $a" ;;
  esac
done

[[ -f "$CONF" ]] || die "$CONF not found"

# ---- parse: KEY=value lines only; the file is never sourced or evaluated ----
declare -A C=( [PROXY_ENABLED]=true )
ALLOWED=" PROXY_ENABLED PROXY_HOST PROXY_PORT DOCKER_PROXY_HOST NO_PROXY "
n=0
while IFS= read -r line || [[ -n "$line" ]]; do
  n=$((n+1))
  [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
  [[ "$line" =~ ^([A-Z_]+)=(.*)$ ]] || die "$CONF:$n: expected KEY=value"
  k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
  [[ "$ALLOWED" == *" $k "* ]] || die "$CONF:$n: unknown key $k"
  case "$v" in
    *[[:space:]\"\'\\\$\`]*) die "$CONF:$n: value of $k must not contain spaces, quotes, backslashes, \$ or backticks" ;;
  esac
  C[$k]="$v"
done < "$CONF"

[[ "${C[PROXY_ENABLED]}" == true || "${C[PROXY_ENABLED]}" == false ]] || die "PROXY_ENABLED must be true or false"
ENABLED=1
[[ "${C[PROXY_ENABLED]}" == true && $FORCE_OFF -eq 0 ]] || ENABLED=0
if [[ $ENABLED -eq 1 ]]; then
  for k in PROXY_HOST PROXY_PORT DOCKER_PROXY_HOST NO_PROXY; do
    [[ -n "${C[$k]:-}" ]] || die "$CONF: $k is required"
  done
  [[ "${C[PROXY_PORT]}" =~ ^[0-9]+$ && ${C[PROXY_PORT]} -ge 1 && ${C[PROXY_PORT]} -le 65535 ]] || die "PROXY_PORT must be 1-65535"
  # The values end up in shell, apt, systemd and git files, so only plain host-name and list characters are allowed.
  for k in PROXY_HOST DOCKER_PROXY_HOST; do
    [[ "${C[$k]}" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || die "$k must be a host name or IPv4 address"
  done
  [[ "${C[NO_PROXY]}" =~ ^[A-Za-z0-9._*:/,-]+$ ]] || die "NO_PROXY may only contain letters, digits and . _ * : / , -"
  PROXY_URL="http://${C[PROXY_HOST]}:${C[PROXY_PORT]}"
  DOCKER_URL="http://${C[DOCKER_PROXY_HOST]}:${C[PROXY_PORT]}"
  NOP="${C[NO_PROXY]}"
fi

STAGE="$(mktemp -d)"; trap 'rm -rf "$STAGE"' EXIT
GENERATED=(etc/profile.d/proxy.sh etc/systemd/system/docker.service.d/http-proxy.conf etc/apt/apt.conf.d/95proxy)
ALWAYS=(etc/environment etc/gitconfig)

put() { mkdir -p "$STAGE/$(dirname "$1")"; cat > "$STAGE/$1"; }

if [[ $ENABLED -eq 1 ]]; then
  put etc/profile.d/proxy.sh <<EOF
# Generated by update-proxy from /etc/proxy.conf
export HTTP_PROXY="${PROXY_URL}"
export HTTPS_PROXY="${PROXY_URL}"
export http_proxy="${PROXY_URL}"
export https_proxy="${PROXY_URL}"
export NO_PROXY="${NOP}"
export no_proxy="${NOP}"
EOF
  put etc/systemd/system/docker.service.d/http-proxy.conf <<EOF
# Generated by update-proxy from /etc/proxy.conf
[Service]
Environment="HTTP_PROXY=${PROXY_URL}"
Environment="HTTPS_PROXY=${PROXY_URL}"
Environment="http_proxy=${PROXY_URL}"
Environment="https_proxy=${PROXY_URL}"
Environment="NO_PROXY=${NOP}"
Environment="no_proxy=${NOP}"
EOF
  put etc/apt/apt.conf.d/95proxy <<EOF
// Generated by update-proxy from /etc/proxy.conf
Acquire::http::Proxy "${PROXY_URL}/";
Acquire::https::Proxy "${PROXY_URL}/";
EOF
fi

# /etc/environment: drop the managed block and the lines the old script wrote, keep everything else
ENVF="$ROOT/etc/environment"
mkdir -p "$STAGE/etc"
{
  if [[ -f "$ENVF" ]]; then
    awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1;next} $0==e{skip=0;next} !skip' "$ENVF" \
      | grep -Ev '^(HTTP_PROXY|HTTPS_PROXY|http_proxy|https_proxy|NO_PROXY|no_proxy|DOCKER_PROXY)=' || true
  fi
  if [[ $ENABLED -eq 1 ]]; then
    printf '%s\n' "$BEGIN" "HTTP_PROXY=${PROXY_URL}" "HTTPS_PROXY=${PROXY_URL}" "http_proxy=${PROXY_URL}" \
      "https_proxy=${PROXY_URL}" "NO_PROXY=${NOP}" "no_proxy=${NOP}" "DOCKER_PROXY=${DOCKER_URL}" "$END"
  fi
} > "$STAGE/etc/environment"

# system git config: only http.proxy / https.proxy are managed
GITF="$ROOT/etc/gitconfig"
[[ -f "$GITF" ]] && cp "$GITF" "$STAGE/etc/gitconfig" || : > "$STAGE/etc/gitconfig"
if [[ $ENABLED -eq 1 ]]; then
  git config --file "$STAGE/etc/gitconfig" http.proxy "$PROXY_URL"
  git config --file "$STAGE/etc/gitconfig" https.proxy "$PROXY_URL"
else
  git config --file "$STAGE/etc/gitconfig" --unset http.proxy 2>/dev/null || true
  git config --file "$STAGE/etc/gitconfig" --unset https.proxy 2>/dev/null || true
fi
# do not create an empty /etc/gitconfig that did not exist before
if [[ ! -f "$GITF" && ! -s "$STAGE/etc/gitconfig" ]]; then rm -f "$STAGE/etc/gitconfig"; fi

changed=()
for rel in "${GENERATED[@]}" "${ALWAYS[@]}"; do
  tgt="$ROOT/$rel"; stg="$STAGE/$rel"
  if [[ -e "$stg" ]]; then
    [[ -e "$tgt" ]] && cmp -s "$stg" "$tgt" || changed+=("$rel")
  else
    [[ -e "$tgt" ]] && changed+=("$rel") || true
  fi
done

if [[ ${#changed[@]} -eq 0 ]]; then echo "update-proxy: no changes"; exit 0; fi

case "$MODE" in
  check) printf 'update-proxy: differs: %s\n' "${changed[@]}"; exit 1 ;;
  dry)
    for rel in "${changed[@]}"; do
      a="$ROOT/$rel"; b="$STAGE/$rel"
      [[ -e "$a" ]] || a=/dev/null; [[ -e "$b" ]] || b=/dev/null
      diff -u --label "current/$rel" --label "new/$rel" "$a" "$b" || true
    done
    exit 0 ;;
esac

for rel in "${changed[@]}"; do
  tgt="$ROOT/$rel"
  if [[ -e "$STAGE/$rel" ]]; then
    mkdir -p "$(dirname "$tgt")"
    # keep a one-time backup of shared files that the script edits in place
    case "$rel" in etc/environment|etc/gitconfig)
      if [[ -f "$tgt" && ! -e "$tgt.update-proxy.bak" ]]; then cp -p "$tgt" "$tgt.update-proxy.bak"; fi ;;
    esac
    # write next to the target and rename, so a crash never leaves a half-written file
    tmp="$(mktemp "$tgt.XXXXXX")"; install -m 0644 "$STAGE/$rel" "$tmp"; mv -fT "$tmp" "$tgt"
    echo "update-proxy: wrote $rel"
  else
    rm -f "$tgt"; echo "update-proxy: removed $rel"
  fi
done

docker_changed=0
for rel in "${changed[@]}"; do [[ "$rel" == etc/systemd/system/docker.service.d/http-proxy.conf ]] && docker_changed=1; done
if [[ $docker_changed -eq 1 ]]; then
  if [[ $SERVICES -eq 1 && -z "$ROOT" ]]; then
    systemctl daemon-reload
    systemctl is-active --quiet docker && systemctl restart docker || true
  else
    echo "update-proxy: docker drop-in changed. Run: systemctl daemon-reload && systemctl restart docker" >&2
    echo "update-proxy: (a restart stops running containers unless live-restore is on)" >&2
  fi
fi
